

### Read in sequence data for the gene
data = readDiscreteCharacterData("/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3.nex")

# Get some useful variables from the data. We need these later on.
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3
taxa <- data.taxa()
num_char <- data.nchar()

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# specify the stationary frequency parameters
pi_prior <- v(1,1,1,1) 
pi ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi, weight=2.0) )
moves.append( mvDirichletSimplex(pi, weight=1.0) )


# specify the exchangeability rate parameters
er_prior <- v(1,1,1,1,1,1)
er ~ dnDirichlet(er_prior)
moves.append( mvBetaSimplex(er, weight=3.0) )
moves.append( mvDirichletSimplex(er, weight=1.5) )


# create a deterministic variable for the rate matrix, GTR
Q := fnGTR(er,pi) 


#############################
# Among Site Rate Variation #
#############################


# among site rate variation
sr <- v(1.7229953, 0.660821,0.6079968,0.8772289,0.509564,0.51419485,0.6883202,0.48141238,0.5270352,1.6943264,1.2731433,0.7386584,0.78218555,1.2226232,1.3316188,2.025689,0.7466973,0.72749305,0.49604946,0.6759478,0.63980305,0.6638476,0.8886898,0.6635934,0.65970886,0.5989685,0.632812,1.0575655,1.0132123,1.1043259,0.6677119,0.6201364,1.0816411,1.7279437,2.182587,0.86076707,0.56670797,0.5512914,0.5480058,0.51740307,0.5416948,1.8793341,2.1255991,1.4378934,2.4442155,0.7375984,0.6479288,0.54074675,0.5370959,0.50656724,0.48028058,0.4258153,0.44359022,0.39484724,0.39775687,0.6018515,0.6946509,0.7899679,0.8626624,0.96766764,0.44453996,0.45649227,0.4504957,0.46115816,0.4026046,0.62213564,0.6292316,0.6128035,0.62526,0.9500174,0.51850224,1.307494,1.3279015,0.68195885,0.74690354,0.74873435,0.5697109,0.5717033,0.7340495,0.6035446,0.5545834,0.5209354,0.5313822,0.6697158,1.9958409,2.403398,2.9008214,3.107181,2.948974,2.8849208,3.0337462,3.1369002,3.1642797,3.4106789,0.1019943,0.10416991,0.13397284,0.2844906,1.1862605,0.4520324)
            

##############
# Tree model #
##############

# Prior distribution on the tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

# Branch length prior
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(16.0)
    moves.append( mvScale(bl[i]) )
}

TL := sum(bl)

psi := treeAssembly(topology, bl)




###################
# PhyloCTMC Model #
###################


###############################################
# Create partitions
###############################################
idx = 1

for (i in 1:int(num_char)) {
    morpho_bystate[i] <- data                              
    morpho_bystate[i].excludeAll()                
    morpho_bystate[i].includeCharacter(i)                            

    ######################
    # Substitution Model #
    ######################    

    m_morph[idx] ~ dnPhyloCTMC( tree=psi,
                                Q=Q,
                                nSites=1,
                                siteRates=v(sr[idx]),
                                type="DNA")           

    m_morph[idx].clamp(morpho_bystate[i])                 

    idx = idx + 1                                       
    # idx
}
        


############
# Analysis #
############

mymodel = model(psi)

# add monitors
monitors.append( mnScreen(TL, printgen=100) )
monitors.append( mnFile(psi, filename="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL.trees", printgen=10) )
monitors.append( mnModel(filename="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL.log", printgen=10) )

# run the analysis
mymcmc = mcmc(mymodel, moves, monitors)
mymcmc.run(generations=10000)


# summarize output
treetrace = readTreeTrace("/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL.trees", treetype="non-clock")
# and then get the MAP tree
map_tree = mapTree(treetrace,"/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL_MAP.tre", ccp=TRUE)
mcc_tree = mccTree(treetrace,"/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL_MCC.tre")
mcr_tree = consensusTree(trace=treetrace, cutoff=0, file="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali3_DL_CT.tre")
q()

    