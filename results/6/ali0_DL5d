

### Read in sequence data for the gene
data = readDiscreteCharacterData("/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0.nex")

# Get some useful variables from the data. We need these later on.
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3
taxa <- data.taxa()
num_char <- data.nchar()

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# specify the stationary frequency parameters
pi_prior <- v(1,1,1,1) 
pi ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi, weight=2.0) )
moves.append( mvDirichletSimplex(pi, weight=1.0) )


# specify the exchangeability rate parameters
er_prior <- v(1,1,1,1,1,1)
er ~ dnDirichlet(er_prior)
moves.append( mvBetaSimplex(er, weight=3.0) )
moves.append( mvDirichletSimplex(er, weight=1.5) )


# create a deterministic variable for the rate matrix, GTR
Q := fnGTR(er,pi) 


#############################
# Among Site Rate Variation #
#############################


# among site rate variation (discrete)
sr <- v(0.9524759352207184, 1.012675288246899,1.0686654789107186,1.1409176588058472,1.2331691980361938)
                        
part_1_indx <- v(2, 3,10,12,14,16,20,22,23,26,38,46,47,49,51,55,56,57,60,62,65,67,68,70,71,72,75,76,77,80,81,82,84,86,87,88,90,91,92,96,97,100)                
                    
part_2_indx <- v(1, 4,6,7,8,9,11,13,21,24,25,28,29,30,32,33,35,36,37,39,41,42,43,44,45,52,54,58,59,64,66,73,74,78,79,83,85,89,93,98,99)                
                    
part_3_indx <- v(15, 18,19,27,31,34,48,50,53,61,63,69,94,95)                
                    
part_4_indx <- v(5, 17)                
                    
part_5_indx <- v(40)                
                    

##############
# Tree model #
##############

# Prior distribution on the tree topology
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

# Branch length prior
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(16.0)
    moves.append( mvScale(bl[i]) )
}

TL := sum(bl)

psi := treeAssembly(topology, bl)




###################
# PhyloCTMC Model #
###################


###############################################
# Create partitions (discretized)
###############################################

part_rate[1] <- data                              
part_rate[1].excludeAll()                
part_rate[1].includeCharacter(part_1_indx) 
dat[1] ~ dnPhyloCTMC( tree=psi, Q=Q, nSites=part_rate[1].nchar(), siteRates=v(sr[1]), type="DNA")           
dat[1].clamp(part_rate[1])  
                
part_rate[2] <- data                              
part_rate[2].excludeAll()                
part_rate[2].includeCharacter(part_2_indx) 
dat[2] ~ dnPhyloCTMC( tree=psi, Q=Q, nSites=part_rate[2].nchar(), siteRates=v(sr[2]), type="DNA")           
dat[2].clamp(part_rate[2])  
                
part_rate[3] <- data                              
part_rate[3].excludeAll()                
part_rate[3].includeCharacter(part_3_indx) 
dat[3] ~ dnPhyloCTMC( tree=psi, Q=Q, nSites=part_rate[3].nchar(), siteRates=v(sr[3]), type="DNA")           
dat[3].clamp(part_rate[3])  
                
part_rate[4] <- data                              
part_rate[4].excludeAll()                
part_rate[4].includeCharacter(part_4_indx) 
dat[4] ~ dnPhyloCTMC( tree=psi, Q=Q, nSites=part_rate[4].nchar(), siteRates=v(sr[4]), type="DNA")           
dat[4].clamp(part_rate[4])  
                
part_rate[5] <- data                              
part_rate[5].excludeAll()                
part_rate[5].includeCharacter(part_5_indx) 
dat[5] ~ dnPhyloCTMC( tree=psi, Q=Q, nSites=part_rate[5].nchar(), siteRates=v(sr[5]), type="DNA")           
dat[5].clamp(part_rate[5])  
                


############
# Analysis #
############

mymodel = model(psi)

# add monitors
monitors.append( mnScreen(TL, printgen=100) )
monitors.append( mnFile(psi, filename="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d.trees", printgen=10) )
monitors.append( mnModel(filename="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d.log", printgen=10) )

# run the analysis
mymcmc = mcmc(mymodel, moves, monitors)
mymcmc.run(generations=10000)


# summarize output
treetrace = readTreeTrace("/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d.trees", treetype="non-clock")
# and then get the MAP tree
map_tree = mapTree(treetrace,"/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d_MAP.tre", ccp=TRUE)
mcc_tree = mccTree(treetrace,"/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d_MCC.tre")
mcr_tree = consensusTree(trace=treetrace, cutoff=0, file="/home/felix/Documents/Seminar/phyloRNN/phyloRNN/ali_tmp/ali0_DL5d_CT.tre")
q()

    